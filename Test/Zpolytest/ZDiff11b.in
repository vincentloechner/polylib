# Difference of two weird Zpolyhedra, one of them is pointy
M 2
4 4
   2    0    0    0 
   0    5    0    0 
  52   27   66    0 
   0    0    0    1 

4 4
  1 0 0 0
  0 0 0 0 # plouf, eliminate j :)
  0 0 1 0
  0 0 0 1

D 2
# first polyhedron: {-50 <= i,j,k <= 50}
6 5
  1 1 0 0  50
  1 -1 0 0 50
  1 0 1 0  50
  1 0 -1 0 50
  1 0 0 1  50
  1 0 0 -1 50

# second polyhedron: a pointy cone (i not bounded)
5 5
  1  1  0  0 0
  1 -1  10  0 0    # j >= i/10 -> will be projected out
  1  1 -9  0 0    # j <= i/9
  1 -4 -1  4 0    # k >= j/4+i
  1  3  1 -3 0    # k <= j/3+i

# ZP diff
F 9

# iscc input:
D1 := {[i, j, k]: -50 <= i,j,k <= 50};
L1 := {[i, j, k] -> [2i, 5j, 52i+27j+66k]};
D2 := {[i, j, k]: i>=0 and i/10 <= j <= i/9 and j/4+i <= k <= j/3+i};
L2 := {[i, j, k] -> [i, 0, k]};
L1(D1) - L2(D2) = {};
L2(D2) - L1(D1) = {};
