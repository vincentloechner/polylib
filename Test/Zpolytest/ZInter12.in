# Intersection of two weird Zpolyhedra, one of them is pointy
# comes from ZDiff11
M 2
# multiplied by 2 for the first one
3 3
   2    0    0 
   0    2    0 
   0    0    1 

3 3
  1 0 0
  0 0 0    # plouf, eliminate j :)
  0 0 1

D 2

# first polyhedron: {-20 <= i,j <= 20}
4 4
  1 1 0  20
  1 -1 0 20
  1 0 1  20
  1 0 -1 20

# second polyhedron: a pointy polyhedron (becomes a real LBL)
4 4
  1  1  0  0
  1 -1  0  100  # 0 <= i <= 100
  1 -1  4  0    # 4j >= i
  1  1 -3  0    # 3j <= i
                # i/4 <= j <= i/3 will be thick starting at i=3
                # (2,0) is not in!

# ZP inter
F 7

