# Complement of a pointy polyhedron, projected on i

M 1

# projection along j
2 3
  1 0 0
  0 0 1

D 1

# a pointy polyhedron
4 4
  1  1  0 0
  1 -1  0 100
  1 -1  30 0  # j >= i/30
  1  1 -20 0  # j <= i/20

# LBL2ZD
# F 17

# check empty intersection with complement
# F 19

# LBLComplement
F 16

# the complement of this pointy LBL should be:
# - i outside of [0, 100]
# - plus 1 <= i <= 19 and 31 <= i <= 39
