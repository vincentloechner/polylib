# Image of a pointy Z-polyhedron by a projection (need LBL)

# image by readMat["(i,j->3i+1,2i+5j)"] of readMat["(i,j->2i,2i+j)"]
M 2
# lattice
3 3
  1 0 0 
  0 1 0
  0 0 1

# affine function (i, j) -> i
2 3
  1 0 0
  0 0 1

#readDom["{i,j| 1<= i,j<=10}"]
D 1

# a very pointy cone : i=0 then holes till i=29/30, then holes, etc...
3 4
1  1  0 0
# 1 -1  0 1000
1 -1  30 0  # j >= i/30
1  1 -29 0  # j <= i/29

# ZDomainImage
F 10
