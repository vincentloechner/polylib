# ZAlloc of a pointy polyhedron, projected on i

M 1

# projection along j
2 3
  1 0 0
  0 0 1

D 1

# a pointy polyhedron: i=0 then i>=2
4 4
  1  1  0 0
  1 -1  0 10
  1 -1  3 0    # j >= i/3
  1  1 -2 0    # j <= i/2


# ZAlloc test
F 100

# the result should be {i=0} U {2 <= i <= 10}
# because there is no integer j for i = 1 (1/3->1/2)
