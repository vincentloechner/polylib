# Difference of two weird LBLs, one of them is pointy
# 2D, simpler than ZDiff11
M 2
# multiplied by 2 for the first one
3 3
  2    0    0 
  0    2    0 
  0    0    1 

3 3
  1 0 0
  0 0 0    # plouf, eliminate j :)
  0 0 1

D 2
# first polyhedron: {-20 <= i,j <= 20}, LBL = image by (2i, 2j)
4 4
  1 1 0  20
  1 -1 0 20
  1 0 1  20
  1 0 -1 20

# second polyhedron: a pointy polyhedron (becomes a real LBL)
# LBL = image by (i, 0), 0 <= i <= 100.
4 4
  1  1  0  0
  1 -1  0  100  # 0 <= i <= 100
  1 -1  4  0    # 4j >= i
  1  1 -3  0    # 3j <= i
                # i/4 <= j <= i/3 will be thick starting at i=3
                # points (1,0) and (2,0) are not in the LBL!

# ZP diff
F 9

# hull(A) = {-40 <= i,j <= 40}
# hull(B) = {(i,0) | 0 <= i <= 100}

# hull(A) - hull(B) = A \ ({j=0} U {-40 <= i <= -1})
