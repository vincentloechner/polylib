prefix=@prefix@
exec_prefix=@exec_prefix@
bindir=@bindir@
libdir=@libdir@
datarootdir=@datarootdir@
datadir=@datadir@
sysconfdir=@sysconfdir@
includedir=@includedir@
package=@PACKAGE@
suffix=

Name: polylib32
Description: polylib32 Library
Version: @PACKAGE_VERSION@
Requires:
Libs: -L${libdir} -lpolylib32 @PC_LDFLAGS@ @LIBS@
Cflags: -I${includedir} @PC_CFLAGS@
