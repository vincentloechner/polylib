prefix=@prefix@
exec_prefix=@exec_prefix@
bindir=@bindir@
libdir=@abs_builddir@/.libs
datarootdir=@datarootdir@
datadir=@datadir@
sysconfdir=@sysconfdir@
includedir=@abs_builddir@/include
includedir2=@abs_srcdir@/include
package=@PACKAGE@
suffix=

Name: polylib64
Description: polylib64 Library (local build)
Version: @PACKAGE_VERSION@
Requires:
Libs: -L${libdir} -Wl,-rpath,${libdir} -lpolylib64 @PC_LDFLAGS@ @LIBS@
Cflags: -I${includedir} -I${includedir2} @PC_CFLAGS@
